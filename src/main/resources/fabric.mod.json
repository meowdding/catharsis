{
  "schemaVersion": 1,
  "id": "katharsis",
  "version": "${version}",
  "name": "Katharsis",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "environment": "*",
  "icon": "assets/katharsis/icon.png",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "me.owdding.katharsis.Katharsis"
      }
    ],
    "packed_packs": [
      {
        "adapter": "kotlin",
        "value": "me.owdding.katharsis.compat.PackedPacksCompat"
      }
    ],
    "jade": [
      {
        "adapter": "kotlin",
        "value": "me.owdding.katharsis.compat.JadeCompat"
      }
    ],
    "skyblock-item-list": [
      {
        "adapter": "kotlin",
        "value": "me.owdding.katharsis.compat.SkyBlockItemListCompat"
      }
    ]
  },
  "mixins": [
    "katharsis.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "${minecraft_range}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_lang_kotlin}",
    "skyblock-api": ">=${sbapi}"
  },
  "accessWidener": "katharsis.accesswidener"
}
